# Root environment for docker compose (copy to .env). No secrets are committed.
POSTGRES_USER=stockiteasy
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=stockiteasy
# Required: at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# true when served over HTTPS
COOKIE_SECURE=false
# Optional SMTP; without it e-mails are written to the API logs
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=StockItEasy <no-reply@example.com>
