# --- StockItEasy API configuration (copy to .env) ---
NODE_ENV=development
PORT=4000
# PostgreSQL connection (docker-compose exposes 5432)
DATABASE_URL=postgresql://stockiteasy:stockiteasy@localhost:5432/stockiteasy?schema=public
# Redis enables BullMQ background jobs (nightly Stock Autopilot). Optional in development.
REDIS_URL=redis://localhost:6379
# 32+ random characters. REQUIRED in production (generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Public URL of the web app (used in e-mail links)
WEB_URL=http://localhost:3000
# Comma-separated origins allowed by CORS (web app, Expo dev server)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Set to true behind HTTPS so the refresh cookie is Secure
COOKIE_SECURE=false
# SMTP (optional). Without it, e-mails are printed in the API logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=StockItEasy <no-reply@example.com>
# Optional Python forecasting service (services/ai). Falls back to the built-in model.
AI_SERVICE_URL=
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=20
