// StockItEasy — PostgreSQL domain model (Phase 1).
//
// Conventions
// - UUID primary keys, generated by the database.
// - Every tenant-owned table carries `organizationId` and every query filters on it.
// - Money: Decimal(14,3) (TND millimes). Unit costs: Decimal(18,6). Quantities: Decimal(18,3).
// - Timestamps are stored in UTC (timestamptz) and converted per user time zone in the clients.
// - Stock is never edited directly: every change goes through InventoryMovement (append-only).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Sector {
  GROCERY
  WHOLESALE
  RETAIL
  AUTO_PARTS
  ELECTRONICS
  COSMETICS
  ECOMMERCE
  MULTI_STORE
  OTHER
}

enum Plan {
  STARTER
  BUSINESS
  PRO_AI
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum ValuationMethod {
  WEIGHTED_AVERAGE
  FIFO
}

enum MemberStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum TokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductTracking {
  NONE
  LOT
  SERIAL
}

enum MovementType {
  OPENING
  RECEIPT
  RECEIPT_REVERSAL
  SALE
  SALE_REVERSAL
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  COUNT_ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  BLOCK
  UNBLOCK
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum CountScope {
  FULL
  PARTIAL
  CYCLE
}

enum CountStatus {
  IN_PROGRESS
  VALIDATED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchaseOrderSource {
  MANUAL
  AUTOPILOT
}

enum ReceiptStatus {
  POSTED
  CANCELLED
}

enum SalesChannel {
  POS
  DIRECT
}

enum SalesStatus {
  COMPLETED
  PARTIALLY_RETURNED
  RETURNED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  CREDIT
  BANK_TRANSFER
  CHECK
  MOBILE
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum RecommendationStatus {
  OPEN
  APPROVED
  MODIFIED
  REJECTED
  EXPIRED
}

enum RecommendationPriority {
  CRITICAL
  RECOMMENDED
  DEFERRABLE
}

enum SyncStatus {
  APPLIED
  CONFLICT
  REJECTED
  DUPLICATE
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  EXPIRY_SOON
  PO_APPROVAL_REQUIRED
  TRANSFER_PENDING
  RECEIPT_INCOMPLETE
  RECOMMENDATION
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String
  fullName        String
  locale          String    @default("fr-TN")
  timezone        String    @default("Africa/Tunis")
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  isSuperAdmin    Boolean   @default(false)
  lastLoginAt     DateTime? @db.Timestamptz(3)
  failedLogins    Int       @default(0)
  lockedUntil     DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  memberships OrganizationMember[]
  sessions    Session[]
  tokens      EmailToken[]

  @@map("users")
}

model EmailToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

/// Refresh-token session. Tokens rotate on every refresh; reusing a rotated
/// token revokes the whole family (theft detection).
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  familyId         String    @db.Uuid
  refreshTokenHash String    @unique
  client           String    @default("web")
  deviceName       String?
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime  @db.Timestamptz(3)
  rotatedAt        DateTime? @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  revokedReason    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model Organization {
  id                    String          @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String          @unique
  sector                Sector          @default(OTHER)
  country               String          @default("TN")
  city                  String?
  address               String?
  phone                 String?
  taxId                 String?
  currency              String          @default("TND")
  timezone              String          @default("Africa/Tunis")
  defaultLocale         String          @default("fr-TN")
  valuationMethod       ValuationMethod @default(WEIGHTED_AVERAGE)
  allowNegativeStock    Boolean         @default(false)
  purchaseBudget        Decimal?        @db.Decimal(14, 3)
  serviceLevel          Decimal         @default(0.95) @db.Decimal(4, 3)
  reviewPeriodDays      Int             @default(7)
  enabledPaymentMethods PaymentMethod[] @default([CASH, CARD, CREDIT])
  isDemo                Boolean         @default(false)
  barcodeSequence       Int             @default(0)
  createdAt             DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @db.Timestamptz(3)

  members      OrganizationMember[]
  roles        Role[]
  subscription Subscription?
  stores       Store[]
  warehouses   Warehouse[]
  products     Product[]

  @@map("organizations")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  key            String?
  name           String
  isSystem       Boolean  @default(false)
  permissions    String[]
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      OrganizationMember[]
  invitations  Invitation[]

  @@unique([organizationId, key])
  @@unique([organizationId, name])
  @@map("roles")
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  roleId         String       @db.Uuid
  status         MemberStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  email          String
  roleId         String    @db.Uuid
  tokenHash      String    @unique
  invitedById    String    @db.Uuid
  expiresAt      DateTime  @db.Timestamptz(3)
  acceptedAt     DateTime? @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  role Role @relation(fields: [roleId], references: [id])

  @@index([organizationId, email])
  @@map("invitations")
}

/// Plan entitlements and quotas. No payment provider is wired yet: plan changes
/// are made by a super admin.
model Subscription {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @unique @db.Uuid
  plan           Plan               @default(STARTER)
  status         SubscriptionStatus @default(TRIAL)
  maxUsers       Int?
  maxWarehouses  Int?
  maxProducts    Int?
  aiEnabled      Boolean            @default(false)
  startedAt      DateTime           @default(now()) @db.Timestamptz(3)
  endsAt         DateTime?          @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// Atomic per-organization document numbering (PO-2026-00001, ...).
model DocumentSequence {
  organizationId String @db.Uuid
  key            String
  nextValue      Int    @default(1)

  @@id([organizationId, key])
  @@map("document_sequences")
}

// ---------------------------------------------------------------------------
// Stores, warehouses, locations
// ---------------------------------------------------------------------------

model Store {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  code           String
  city           String?
  address        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouses   Warehouse[]

  @@unique([organizationId, code])
  @@map("stores")
}

model Warehouse {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  storeId        String?  @db.Uuid
  name           String
  code           String
  city           String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store?             @relation(fields: [storeId], references: [id])
  locations    Location[]
  balances     InventoryBalance[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("warehouses")
}

model Location {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  warehouseId    String   @db.Uuid
  code           String
  zone           String?
  aisle          String?
  shelf          String?
  bin            String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, code])
  @@map("locations")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model ProductCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  parentId       String?  @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([organizationId, parentId, name])
  @@index([organizationId])
  @@map("product_categories")
}

/// Every sellable item is a Product row. A variant is a Product with a
/// `parentId` and `variantAttributes` (size, colour...).
model Product {
  id                  String          @id @default(uuid()) @db.Uuid
  organizationId      String          @db.Uuid
  sku                 String
  name                String
  description         String?
  categoryId          String?         @db.Uuid
  brand               String?
  baseUnit            String          @default("pc")
  allowFractionalQty  Boolean         @default(false)
  tracking            ProductTracking @default(NONE)
  hasExpiry           Boolean         @default(false)
  purchasePrice       Decimal         @default(0) @db.Decimal(14, 3)
  salePrice           Decimal         @default(0) @db.Decimal(14, 3)
  minSalePrice        Decimal?        @db.Decimal(14, 3)
  averageCost         Decimal         @default(0) @db.Decimal(18, 6)
  taxRate             Decimal         @default(19) @db.Decimal(5, 2)
  minStock            Decimal         @default(0) @db.Decimal(18, 3)
  maxStock            Decimal?        @db.Decimal(18, 3)
  preferredSupplierId String?         @db.Uuid
  parentId            String?         @db.Uuid
  variantAttributes   Json?
  status              ProductStatus   @default(ACTIVE)
  isDemo              Boolean         @default(false)
  version             Int             @default(1)
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category          ProductCategory?   @relation(fields: [categoryId], references: [id])
  preferredSupplier Supplier?          @relation("PreferredSupplier", fields: [preferredSupplierId], references: [id])
  parent            Product?           @relation("Variants", fields: [parentId], references: [id])
  variants          Product[]          @relation("Variants")
  barcodes          ProductBarcode[]
  conversions       UnitConversion[]
  images            ProductImage[]
  balances          InventoryBalance[]
  supplierProducts  SupplierProduct[]

  @@unique([organizationId, sku])
  @@index([organizationId, status])
  @@index([organizationId, categoryId])
  @@index([organizationId, name])
  @@map("products")
}

model ProductBarcode {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  productId      String   @db.Uuid
  code           String
  /// Packaging unit scanned with this code (null = base unit).
  unitCode       String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([productId])
  @@map("product_barcodes")
}

/// 1 `unitCode` = `factor` × product base unit.
model UnitConversion {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  productId      String  @db.Uuid
  unitCode       String
  factor         Decimal @db.Decimal(18, 6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, unitCode])
  @@map("unit_conversions")
}

model ProductImage {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  productId      String   @db.Uuid
  url            String
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

/// Current stock of a product in a warehouse.
/// available = quantityOnHand − quantityReserved − quantityBlocked.
model InventoryBalance {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  productId        String   @db.Uuid
  warehouseId      String   @db.Uuid
  quantityOnHand   Decimal  @default(0) @db.Decimal(18, 3)
  quantityReserved Decimal  @default(0) @db.Decimal(18, 3)
  quantityBlocked  Decimal  @default(0) @db.Decimal(18, 3)
  version          Int      @default(0)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@index([organizationId, warehouseId])
  @@map("inventory_balances")
}

/// Append-only stock ledger. `quantity` is signed (+ in, − out) on quantityOnHand,
/// except BLOCK/UNBLOCK which move quantity between available and blocked.
model InventoryMovement {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  productId      String       @db.Uuid
  warehouseId    String       @db.Uuid
  type           MovementType
  quantity       Decimal      @db.Decimal(18, 3)
  unitCost       Decimal      @default(0) @db.Decimal(18, 6)
  totalCost      Decimal      @default(0) @db.Decimal(18, 3)
  balanceAfter   Decimal      @db.Decimal(18, 3)
  reason         String?
  note           String?
  referenceType  String?
  referenceId    String?      @db.Uuid
  lotId          String?      @db.Uuid
  userId         String?      @db.Uuid
  occurredAt     DateTime     @default(now()) @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([organizationId, occurredAt])
  @@index([organizationId, productId, occurredAt])
  @@index([organizationId, warehouseId, occurredAt])
  @@index([organizationId, type, occurredAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

model InventoryReservation {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  productId      String            @db.Uuid
  warehouseId    String            @db.Uuid
  quantity       Decimal           @db.Decimal(18, 3)
  status         ReservationStatus @default(ACTIVE)
  reference      String?
  expiresAt      DateTime?         @db.Timestamptz(3)
  createdById    String?           @db.Uuid
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  releasedAt     DateTime?         @db.Timestamptz(3)

  @@index([organizationId, status])
  @@index([productId, warehouseId, status])
  @@map("inventory_reservations")
}

/// Lots for traceability and FEFO consumption (earliest expiry first).
model InventoryLot {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  productId      String    @db.Uuid
  warehouseId    String    @db.Uuid
  lotNumber      String
  expiryDate     DateTime? @db.Date
  quantity       Decimal   @default(0) @db.Decimal(18, 3)
  receivedAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([productId, warehouseId, lotNumber])
  @@index([organizationId, expiryDate])
  @@map("inventory_lots")
}

/// FIFO cost layers (used when the organization values stock with FIFO).
model CostLayer {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  productId      String   @db.Uuid
  warehouseId    String   @db.Uuid
  originalQty    Decimal  @db.Decimal(18, 3)
  remainingQty   Decimal  @db.Decimal(18, 3)
  unitCost       Decimal  @db.Decimal(18, 6)
  sourceType     String
  sourceId       String?  @db.Uuid
  receivedAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([productId, warehouseId, receivedAt])
  @@map("cost_layers")
}

model SerialNumber {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  productId      String   @db.Uuid
  serial         String
  warehouseId    String?  @db.Uuid
  status         String   @default("IN_STOCK")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@unique([organizationId, productId, serial])
  @@map("serial_numbers")
}

model StockTransfer {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  number          String
  fromWarehouseId String         @db.Uuid
  toWarehouseId   String         @db.Uuid
  status          TransferStatus @default(DRAFT)
  note            String?
  createdById     String?        @db.Uuid
  shippedAt       DateTime?      @db.Timestamptz(3)
  receivedAt      DateTime?      @db.Timestamptz(3)
  cancelledAt     DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  lines StockTransferLine[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@map("stock_transfers")
}

model StockTransferLine {
  id               String   @id @default(uuid()) @db.Uuid
  transferId       String   @db.Uuid
  productId        String   @db.Uuid
  quantity         Decimal  @db.Decimal(18, 3)
  quantityReceived Decimal? @db.Decimal(18, 3)
  unitCost         Decimal  @default(0) @db.Decimal(18, 6)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@map("stock_transfer_lines")
}

model PhysicalInventory {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  number         String
  warehouseId    String      @db.Uuid
  scope          CountScope  @default(PARTIAL)
  status         CountStatus @default(IN_PROGRESS)
  note           String?
  createdById    String?     @db.Uuid
  validatedById  String?     @db.Uuid
  validatedAt    DateTime?   @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  lines InventoryCountLine[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@map("physical_inventories")
}

/// `expectedQty` is the theoretical on-hand quantity captured when the line was
/// counted; the variance (counted − expected) is posted on validation.
model InventoryCountLine {
  id          String    @id @default(uuid()) @db.Uuid
  countId     String    @db.Uuid
  productId   String    @db.Uuid
  expectedQty Decimal   @db.Decimal(18, 3)
  countedQty  Decimal?  @db.Decimal(18, 3)
  countedById String?   @db.Uuid
  countedAt   DateTime? @db.Timestamptz(3)
  version     Int       @default(0)

  count PhysicalInventory @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@unique([countId, productId])
  @@map("inventory_count_lines")
}

// ---------------------------------------------------------------------------
// Purchasing
// ---------------------------------------------------------------------------

model Supplier {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  name             String
  code             String?
  contactName      String?
  phone            String?
  whatsapp         String?
  email            String?
  address          String?
  city             String?
  taxId            String?
  paymentTermsDays Int      @default(0)
  leadTimeDays     Int      @default(7)
  minOrderAmount   Decimal? @db.Decimal(14, 3)
  notes            String?
  isActive         Boolean  @default(true)
  isDemo           Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  products          SupplierProduct[]
  preferredProducts Product[]         @relation("PreferredSupplier")
  purchaseOrders    PurchaseOrder[]

  @@index([organizationId, name])
  @@map("suppliers")
}

model SupplierProduct {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  supplierId     String   @db.Uuid
  productId      String   @db.Uuid
  supplierSku    String?
  unitPrice      Decimal  @db.Decimal(14, 3)
  minOrderQty    Decimal? @db.Decimal(18, 3)
  packSize       Decimal? @db.Decimal(18, 3)
  leadTimeDays   Int?
  isPreferred    Boolean  @default(false)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([organizationId, productId])
  @@map("supplier_products")
}

model SupplierPriceHistory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  supplierId     String   @db.Uuid
  productId      String   @db.Uuid
  unitPrice      Decimal  @db.Decimal(14, 3)
  source         String
  sourceId       String?  @db.Uuid
  recordedAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([organizationId, supplierId, productId, recordedAt])
  @@map("supplier_price_history")
}

model PurchaseOrder {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String              @db.Uuid
  number           String
  supplierId       String              @db.Uuid
  warehouseId      String              @db.Uuid
  status           PurchaseOrderStatus @default(DRAFT)
  source           PurchaseOrderSource @default(MANUAL)
  orderDate        DateTime            @default(now()) @db.Timestamptz(3)
  expectedDate     DateTime?           @db.Date
  currency         String              @default("TND")
  subtotal         Decimal             @default(0) @db.Decimal(14, 3)
  taxTotal         Decimal             @default(0) @db.Decimal(14, 3)
  total            Decimal             @default(0) @db.Decimal(14, 3)
  notes            String?
  createdById      String?             @db.Uuid
  approvedById     String?             @db.Uuid
  approvedAt       DateTime?           @db.Timestamptz(3)
  sentAt           DateTime?           @db.Timestamptz(3)
  receivedAt       DateTime?           @db.Timestamptz(3)
  cancelledAt      DateTime?           @db.Timestamptz(3)
  recommendationId String?             @db.Uuid
  isDemo           Boolean             @default(false)
  version          Int                 @default(1)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String  @id @default(uuid()) @db.Uuid
  purchaseOrderId  String  @db.Uuid
  productId        String  @db.Uuid
  quantity         Decimal @db.Decimal(18, 3)
  quantityReceived Decimal @default(0) @db.Decimal(18, 3)
  unitPrice        Decimal @db.Decimal(14, 3)
  taxRate          Decimal @default(19) @db.Decimal(5, 2)
  lineTotal        Decimal @default(0) @db.Decimal(14, 3)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @db.Uuid
  number          String
  purchaseOrderId String        @db.Uuid
  warehouseId     String        @db.Uuid
  status          ReceiptStatus @default(POSTED)
  note            String?
  receivedById    String?       @db.Uuid
  receivedAt      DateTime      @default(now()) @db.Timestamptz(3)
  cancelledAt     DateTime?     @db.Timestamptz(3)

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  lines         GoodsReceiptLine[]

  @@unique([organizationId, number])
  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                String    @id @default(uuid()) @db.Uuid
  receiptId         String    @db.Uuid
  poLineId          String    @db.Uuid
  productId         String    @db.Uuid
  quantity          Decimal   @db.Decimal(18, 3)
  unitCost          Decimal   @db.Decimal(18, 6)
  lotNumber         String?
  expiryDate        DateTime? @db.Date
  discrepancyReason String?

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@map("goods_receipt_lines")
}

// ---------------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------------

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  phone          String?
  email          String?
  address        String?
  city           String?
  taxId          String?
  creditLimit    Decimal? @db.Decimal(14, 3)
  balance        Decimal  @default(0) @db.Decimal(14, 3)
  notes          String?
  isActive       Boolean  @default(true)
  isDemo         Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  sales SalesOrder[]

  @@index([organizationId, name])
  @@map("customers")
}

model SalesOrder {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  number         String
  customerId     String?       @db.Uuid
  warehouseId    String        @db.Uuid
  channel        SalesChannel  @default(POS)
  status         SalesStatus   @default(COMPLETED)
  subtotal       Decimal       @default(0) @db.Decimal(14, 3)
  discountTotal  Decimal       @default(0) @db.Decimal(14, 3)
  taxTotal       Decimal       @default(0) @db.Decimal(14, 3)
  total          Decimal       @default(0) @db.Decimal(14, 3)
  costTotal      Decimal       @default(0) @db.Decimal(14, 3)
  paidTotal      Decimal       @default(0) @db.Decimal(14, 3)
  refundedTotal  Decimal       @default(0) @db.Decimal(14, 3)
  paymentStatus  PaymentStatus @default(UNPAID)
  note           String?
  createdById    String?       @db.Uuid
  isDemo         Boolean       @default(false)
  completedAt    DateTime      @default(now()) @db.Timestamptz(3)
  cancelledAt    DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  customer Customer?        @relation(fields: [customerId], references: [id])
  lines    SalesOrderLine[]
  payments Payment[]
  returns  CustomerReturn[]

  @@unique([organizationId, number])
  @@index([organizationId, completedAt])
  @@index([organizationId, customerId])
  @@map("sales_orders")
}

model SalesOrderLine {
  id           String  @id @default(uuid()) @db.Uuid
  salesOrderId String  @db.Uuid
  productId    String  @db.Uuid
  quantity     Decimal @db.Decimal(18, 3)
  returnedQty  Decimal @default(0) @db.Decimal(18, 3)
  unitPrice    Decimal @db.Decimal(14, 3)
  discountRate Decimal @default(0) @db.Decimal(5, 2)
  taxRate      Decimal @default(19) @db.Decimal(5, 2)
  netTotal     Decimal @db.Decimal(14, 3)
  taxTotal     Decimal @db.Decimal(14, 3)
  lineTotal    Decimal @db.Decimal(14, 3)
  unitCost     Decimal @default(0) @db.Decimal(18, 6)
  costTotal    Decimal @default(0) @db.Decimal(14, 3)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("sales_order_lines")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  salesOrderId   String        @db.Uuid
  method         PaymentMethod
  amount         Decimal       @db.Decimal(14, 3)
  reference      String?
  isRefund       Boolean       @default(false)
  receivedById   String?       @db.Uuid
  paidAt         DateTime      @default(now()) @db.Timestamptz(3)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([organizationId, paidAt])
  @@map("payments")
}

model CustomerReturn {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  number         String
  salesOrderId   String   @db.Uuid
  reason         String
  restock        Boolean  @default(true)
  amount         Decimal  @default(0) @db.Decimal(14, 3)
  lines          Json
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])

  @@unique([organizationId, number])
  @@map("customer_returns")
}

// ---------------------------------------------------------------------------
// Stock Autopilot
// ---------------------------------------------------------------------------

model ReplenishmentRecommendation {
  id              String                 @id @default(uuid()) @db.Uuid
  organizationId  String                 @db.Uuid
  productId       String                 @db.Uuid
  warehouseId     String                 @db.Uuid
  supplierId      String?                @db.Uuid
  status          RecommendationStatus   @default(OPEN)
  priority        RecommendationPriority
  method          String
  available       Decimal                @db.Decimal(18, 3)
  onOrder         Decimal                @db.Decimal(18, 3)
  averageDaily    Decimal?               @db.Decimal(18, 4)
  leadTimeDays    Int
  daysOfCover     Decimal?               @db.Decimal(10, 1)
  stockoutDate    DateTime?              @db.Date
  suggestedQty    Decimal                @db.Decimal(18, 3)
  unitCost        Decimal                @db.Decimal(18, 6)
  estimatedCost   Decimal                @db.Decimal(14, 3)
  confidence      String
  reasons         Json
  assumptions     Json
  computedAt      DateTime               @default(now()) @db.Timestamptz(3)
  decidedAt       DateTime?              @db.Timestamptz(3)
  decidedById     String?                @db.Uuid
  decisionQty     Decimal?               @db.Decimal(18, 3)
  decisionReason  String?
  purchaseOrderId String?                @db.Uuid

  @@index([organizationId, status])
  @@index([organizationId, productId, warehouseId, status])
  @@map("replenishment_recommendations")
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String?          @db.Uuid
  type           NotificationType
  params         Json
  link           String?
  dedupeKey      String?
  readAt         DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  userId         String?  @db.Uuid
  action         String
  entityType     String?
  entityId       String?
  data           Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

/// Stored responses for requests sent with an Idempotency-Key header.
model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  scope          String
  key            String
  requestHash    String
  statusCode     Int?
  responseBody   Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime @db.Timestamptz(3)

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

/// Mobile offline operations, keyed by the client-generated id so that a
/// replayed operation is never applied twice.
model SyncOperation {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  userId         String     @db.Uuid
  deviceId       String
  clientOpId     String
  type           String
  payload        Json
  status         SyncStatus
  result         Json?
  clientCreatedAt DateTime  @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)

  @@unique([organizationId, clientOpId])
  @@index([organizationId, deviceId])
  @@map("sync_operations")
}
